[Unit]
Description=chat-uses desktop session: Xfce on :0 as user chat
Requires=chat-xvnc.service
Wants=chat-audio.service
After=chat-xvnc.service chat-audio.service

[Service]
User=chat
WorkingDirectory=/home/chat
# The locale (LANG) lives in /etc/default/locale: without it bash runs in
# the C locale and drops what chat types with accents.
EnvironmentFile=-/etc/default/locale
EnvironmentFile=-/etc/environment
Environment=DISPLAY=:0 HOME=/home/chat XDG_RUNTIME_DIR=/run/chat-session XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE PULSE_SERVER=unix:/run/chat-audio/native
RuntimeDirectory=chat-session
# Wait for the X server socket before starting the session.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 100); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 0.1; done; exit 1'
ExecStart=/usr/bin/startxfce4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
