# chat-uses brain settings, rendered at image build from host.env.
# Override any of them in /etc/chat-uses/brain.local.env (deploy.sh pushes
# the host's /etc/chat-uses/brain.local.env there).

# The desktop chat controls, over VNC: the target on stream
# (images/debian-xfce/deploy.sh launches it at TARGET_IP).
TARGET_HOST=${TARGET_IP}
VNC_PORT=${VNC_PORT}

# The overlay feed (/ws/overlay, for bcast's layout page) and /healthz.
BRAIN_BIND=0.0.0.0
BRAIN_PORT=${BRAIN_PORT}

BRAIN_DB=/var/lib/chat-brain/brain.db
# Console: chat-brain-say and chat-brain-admin talk to brain here (root and
# brain only).
BRAIN_CONSOLE=/run/chat-brain/console.sock

# Chat adapters. Each stays off while its secret is missing (deploy.sh pushes
# them from the host's /etc/chat-uses/secrets/).
# YouTube: an API key; which video's chat to read is set with
# `chat-brain-admin youtube VIDEO_ID_OR_URL`.
YOUTUBE_KEY_FILE=/etc/chat-uses/secrets/google-api-key
# Discord: the bot token, and the server's ID (Developer Mode → right-click the
# server → Copy Server ID). Commands are read in this channel only.
DISCORD_TOKEN_FILE=/etc/chat-uses/secrets/discord-bot-token
DISCORD_GUILD_ID=
DISCORD_CHANNEL=control
# Where moderators get alerts (panics, bans, lockdowns, snapshots, screen
# OCR), and where the watchdog reports the target's health.
DISCORD_ALERTS_CHANNEL=mod-alerts
DISCORD_OPS_CHANNEL=ops
# Where a dead run's card goes (Phase 8).
DISCORD_GRAVEYARD_CHANNEL=graveyard
# Where unlocked achievements are announced (Phase 8).
DISCORD_ACHIEVEMENTS_CHANNEL=achievements

# The host's Incus API, for the forensic snapshot a panic takes (PLAN.md
# 7.5). brain's certificate only reaches the targets project
# (bootstrap.sh incus-api; deploy.sh pushes it). The target's instance is
# found by TARGET_HOST, or named here.
INCUS_URL=https://${INFRANET_GW}:${INCUS_API_PORT}
INCUS_PROJECT=targets
TARGET_INSTANCE=

# The admin dashboard (http://${BRAIN_IP}:${BRAIN_PORT}/admin, over WireGuard)
# and its API need this token; deploy.sh makes it on the host
# (/etc/chat-uses/secrets/brain-admin-token) and pushes it.
ADMIN_TOKEN_FILE=/etc/chat-uses/secrets/admin-token

# Screen OCR (PLAN.md 7.4): the target's screen is read every OCR_INTERVAL
# seconds and looked up in the slur lists. shadow: a hit is posted in
# #mod-alerts with the screenshot, nothing happens on stream (start here).
# enforce: a hit holds the stream ("Content check") until a moderator
# resumes. off. OCR_LANGS: tesseract's languages. eng reads French, Spanish
# and Italian well enough (the lists ignore accents); ara for Arabic. Each
# language makes a read slower (docs/phase5.md step 4).
OCR_MODE=shadow
OCR_INTERVAL=5
OCR_LANGS=eng+ara
SCREENS_DIR=/var/lib/chat-brain/screens
