#!/bin/bash
# On air or off: whether the stream goes to YouTube (/usr/lib/chat-bcast/air.py).
#   chat-bcast-air on [BY]     YouTube gets the stream
#   chat-bcast-air off [BY]    nothing goes to YouTube
#   chat-bcast-air status
# From the host: infra/host/onair.sh on|off|status.
exec python3 /usr/lib/chat-bcast/air.py "$@"
