#!/usr/bin/python3
"""Pull the target's sound into the stream, steady and in time.

The target serves raw PCM (s16le, 48 kHz, stereo) on TCP AUDIO_PORT; pacat
plays it into the sink "target", which feeds "mix" (apply-mute mutes it for
a scene or a panic).

This is a jitter buffer. The target is chat's machine and often busy, so its
sound arrives in bursts; a player fed straight from the socket runs dry
between them, which plays as cuts (found on the server with the target at
its CPU cap). So the relay holds AUDIO_BUFFER_MS of sound and feeds pacat at
exactly real-time pace by the clock: a burst up to that late plays without a
cut. The encoder's AUDIO_DELAY shifts the sound back by the same amount.

Sound later than that is replaced by silence where it was due, and dropped
when it finally arrives; a backlog that builds up anyway (pacat fell behind,
or a burst beyond the buffer) is dropped too. Queueing either would leave the
sound late against the picture for the rest of the stream. Every cut and
every drop is logged.

A stall or disconnect ends the script; systemd restarts it, which also
follows the target through reboots. The limiter (chat can't blast the
stream) is in the encoder, on the whole mix.
"""

import fcntl
import os
import select
import socket
import struct
import subprocess
import sys
import termios
import time

FRAME = 4  # bytes per sample frame: 2 channels x 16 bit
RATE = 192000  # bytes per second
MS = 192  # bytes per millisecond
TICK = 0.01  # seconds between writes to pacat
CHUNK = 4096  # bytes per pipe write (21 ms); <= PIPE_BUF, so atomic
PIPE_BYTES = 16384  # the pipe to pacat holds at most ~85 ms
SURPLUS = 100 * MS  # sound held beyond the buffer that gets dropped
LOW = 15 * MS  # when pacat is behind, the pipe drains down to this
SETTLE = 40 * MS  # a pipe backlog that never falls below this...
WINDOW = 10  # ...for this many seconds is drained too
TIMEOUT = 5  # seconds without data = the target is gone


def log(message):
    print(f"{time.strftime('%H:%M:%S')} {message}", file=sys.stderr, flush=True)


def apply_scene_mute():
    """Mute the target as the scene and the panic state say (apply-mute).

    PulseAudio forgets the mute when it restarts, and this script restarts
    with it: the control files stay the one source of truth.
    """
    subprocess.run(["/usr/lib/chat-bcast/apply-mute"], check=False, stdout=subprocess.DEVNULL)


def backlog(fd):
    """Bytes waiting in the pipe (Linux answers FIONREAD on the write end too)."""
    return struct.unpack("i", fcntl.ioctl(fd, termios.FIONREAD, b"\0\0\0\0"))[0]


def frames(n):
    return n - n % FRAME


def main():
    host, port = os.environ["TARGET_HOST"], int(os.environ["AUDIO_PORT"])
    target = frames(int(os.environ.get("AUDIO_BUFFER_MS") or 120) * MS)
    apply_scene_mute()
    try:
        sock = socket.create_connection((host, port), timeout=TIMEOUT)
    except OSError as err:
        sys.exit(f"cannot reach {host}:{port}: {err}")
    sock.setblocking(False)
    player = subprocess.Popen(
        ["pacat", "--playback", "--raw", "--format=s16le", "--rate=48000", "--channels=2",
         "--latency-msec=40", "--device=target", "--client-name=chat-bcast-audio-in",
         "--stream-name=target"],
        stdin=subprocess.PIPE)
    out = player.stdin.fileno()
    fcntl.fcntl(out, fcntl.F_SETPIPE_SZ, PIPE_BYTES)
    os.set_blocking(out, False)

    held = bytearray()  # sound received, not yet given to pacat
    pending = b""  # tail of the last read that wasn't a whole frame
    late = 0  # bytes played as silence; that much late sound gets dropped
    cut = 0  # bytes of silence in the current cut, for the log
    draining = None  # why pacat is being let catch up, or None
    behind = 0  # bytes left out while it does
    start = written = None  # playback clock, and bytes due by it so far
    last_data = time.monotonic()
    floor, window_start = PIPE_BYTES, last_data  # lowest pipe backlog this window

    while True:
        readable, _, _ = select.select([sock], [], [], TICK)
        now = time.monotonic()
        if readable:
            data = sock.recv(65536)
            if not data:
                sys.exit(f"{host}:{port} closed the connection")
            last_data = now
            data = pending + data
            whole = frames(len(data))
            pending = data[whole:]
            data = data[:whole]
            if late:  # its moment has passed: silence was played instead
                dropped = min(late, len(data))
                data = data[dropped:]
                late -= dropped
            held += data
        elif now - last_data > TIMEOUT:
            sys.exit(f"no sound data from {host}:{port} for {TIMEOUT} s")

        if start is None:  # fill the buffer before playing
            if len(held) >= target:
                start, written = now, 0
            continue
        due = frames(int((now - start) * RATE)) - written
        if due <= 0:
            continue
        written += due

        if len(held) > target + SURPLUS:  # bursts beyond the buffer
            extra = frames(len(held) - target)
            del held[:extra]
            log(f"ahead: dropped {extra // MS} ms of sound to stay in time")

        out_bytes = bytes(held[:due])
        del held[:due]
        if len(out_bytes) < due:  # nothing to play: the target is late
            missing = due - len(out_bytes)
            out_bytes += bytes(missing)
            late += missing
            cut += missing
        elif cut:
            log(f"cut: the target's sound was {cut / MS:.1f} ms late")
            cut = 0

        # pacat behind (a stall here): what waits in the pipe only drains in
        # real time, so let it drain to LOW in one go instead of leaving it
        # nearly full, where every later burst would overflow into a click.
        waiting = backlog(out)
        floor = min(floor, waiting)
        if now - window_start >= WINDOW:
            if floor > SETTLE and not draining:
                draining = f"{floor // MS} ms backlog for {WINDOW} s"
            floor, window_start = PIPE_BYTES, now
        if draining:
            if waiting > LOW:
                behind += len(out_bytes)
                continue
            log(f"behind ({draining}): dropped {behind // MS} ms of sound so pacat catches up")
            draining, behind = None, 0

        for i in range(0, len(out_bytes), CHUNK):
            try:
                os.write(out, out_bytes[i:i + CHUNK])
            except BlockingIOError:
                draining = "pipe full"
                behind += len(out_bytes) - i
                break
            except BrokenPipeError:
                sys.exit("pacat exited")


if __name__ == "__main__":
    main()
