#!/bin/bash
# Relay "live" from MediaMTX to YouTube without re-encoding. If YouTube
# drops, only this restarts; the encoder keeps running. Only on air
# (chat-bcast-air, air.py): after a server restart, nothing goes to YouTube
# until someone puts it back on air. A dry run (FORWARD_URL) always runs.
# Note: ffmpeg may print the ingest URL, key included, in errors. The journal
# stays inside bcast.
set -eu
key_file=/etc/chat-uses/secrets/youtube-stream-key
if [[ -n ${FORWARD_URL:-} ]]; then
	url=$FORWARD_URL
elif [[ -r $key_file && -s $key_file ]]; then
	if ! python3 /usr/lib/chat-bcast/air.py check; then
		echo "off air: nothing goes to YouTube ($(python3 /usr/lib/chat-bcast/air.py status)); chat-bcast-air on, or on the host infra/host/onair.sh on"
		until python3 /usr/lib/chat-bcast/air.py check; do sleep 2; done
		echo "on air"
	fi
	url="$YOUTUBE_INGEST/$(tr -d '[:space:]' <"$key_file")"
else
	echo "idle: no stream key in $key_file and no FORWARD_URL"
	exec sleep infinity
fi
# At boot this starts before the encoder publishes "live": wait for it, so a
# normal start doesn't fail once and leave an error in the journal.
live=rtmp://127.0.0.1:1935/live
if ! timeout 10 ffprobe -v quiet -i "$live" </dev/null; then
	echo "waiting for the encoder to publish $live"
	until timeout 10 ffprobe -v quiet -i "$live" </dev/null; do sleep 2; done
fi
# Read over RTMP like the encoder publishes (one clock for both tracks). Over
# RTSP, MediaMTX's AAC packets also carry no keyframe flag, and -c copy drops
# every packet until it sees one: the audio would silently vanish.
exec ffmpeg -nostdin -hide_banner -loglevel warning \
	-i "$live" -map 0:v -map 0:a -c copy -f flv "$url"
