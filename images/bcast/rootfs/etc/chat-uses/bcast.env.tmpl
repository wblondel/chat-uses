# chat-uses broadcast settings, rendered at image build from host.env.
# Override any of them in /etc/chat-uses/bcast.local.env (deploy.sh pushes
# the host's /etc/chat-uses/bcast.local.env there).

# The target on stream: VNC for the picture, raw PCM for the sound.
TARGET_HOST=${TARGET_IP}
VNC_PORT=${VNC_PORT}
AUDIO_PORT=${AUDIO_PORT}

# brain's overlay websocket (Phase 4). The page shows "Controls offline"
# until it answers.
BRAIN_URL=ws://${BRAIN_IP}:${BRAIN_PORT}/ws/overlay

# Encoder (PLAN.md 5.5). YouTube 1080p30: 4-10 Mbps CBR.
FPS=30
VIDEO_BITRATE=7000k
X264_PRESET=veryfast
AUDIO_BITRATE=128k

# Limiter ceiling on the stream's sound, target and layout alike (0.0625-1):
# chat can't blast the stream.
AUDIO_LIMIT=0.8
# Above this level (0-1; 0.14 is -17 dB) the whole mix is compressed 20:1, so
# chat's loudest noise stays near YouTube's reference loudness (-14 LUFS)
# instead of ear-splitting. Normal sound stays below it. 1 turns it off.
AUDIO_COMPRESS=0.14
# The target's sound is held this long before it plays (a jitter buffer):
# under load, chat's machine sends its sound in bursts, and a smaller buffer
# plays the gaps between them as cuts. Longer covers bigger hiccups, but the
# sound gets later: change AUDIO_DELAY by the same amount.
AUDIO_BUFFER_MS=120
# Shift the sound against the picture (an ffmpeg duration: 40ms later,
# -40ms earlier). -100ms compensates the buffer above (measured: it adds
# about 100 ms). images/bcast/check.sh measures the offset to correct.
AUDIO_DELAY=-100ms

# YouTube ingest. The stream key is a secret: deploy.sh pushes
# /etc/chat-uses/secrets/youtube-stream-key. FORWARD_URL, if set, replaces
# YouTube entirely: rtmp://127.0.0.1:1935/dryrun/test sends the stream back
# into MediaMTX for a dry run (RTMP URLs need an app and a stream name).
YOUTUBE_INGEST=rtmps://a.rtmps.youtube.com/live2
FORWARD_URL=

# Extra Chromium flags, e.g. --no-sandbox if its sandbox can't start here.
CHROMIUM_FLAGS=
