[Unit]
Description=chat-uses broadcast: 1080p30 x264 encoder, limiter and watchdog, RTMP into MediaMTX
PartOf=chat-bcast.target
Wants=chat-bcast-xvfb.service chat-bcast-audio.service chat-bcast-mediamtx.service chat-bcast-browser.service
After=chat-bcast-xvfb.service chat-bcast-audio.service chat-bcast-mediamtx.service chat-bcast-browser.service

[Service]
User=bcast
EnvironmentFile=/etc/chat-uses/bcast.env
EnvironmentFile=-/etc/chat-uses/bcast.local.env
Environment=HOME=/var/lib/chat-bcast DISPLAY=:99 PULSE_SERVER=unix:/run/chat-bcast-audio/native
ExecStart=/usr/lib/chat-bcast/encode
Restart=always
RestartSec=2

[Install]
WantedBy=chat-bcast.target
