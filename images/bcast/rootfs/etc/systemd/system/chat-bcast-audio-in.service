[Unit]
Description=chat-uses broadcast: target sound into the mixer, through a limiter
PartOf=chat-bcast.target
Wants=chat-bcast-audio.service
After=chat-bcast-audio.service

[Service]
User=bcast
EnvironmentFile=/etc/chat-uses/bcast.env
EnvironmentFile=-/etc/chat-uses/bcast.local.env
Environment=HOME=/var/lib/chat-bcast DISPLAY=:99 PULSE_SERVER=unix:/run/chat-bcast-audio/native
ExecStart=/usr/lib/chat-bcast/audio-in
Restart=always
RestartSec=2

[Install]
WantedBy=chat-bcast.target
