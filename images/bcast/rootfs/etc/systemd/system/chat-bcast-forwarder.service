[Unit]
Description=chat-uses broadcast: relay to YouTube
PartOf=chat-bcast.target
Wants=chat-bcast-mediamtx.service
After=chat-bcast-mediamtx.service chat-bcast-encoder.service

[Service]
User=bcast
EnvironmentFile=/etc/chat-uses/bcast.env
EnvironmentFile=-/etc/chat-uses/bcast.local.env
Environment=HOME=/var/lib/chat-bcast DISPLAY=:99 PULSE_SERVER=unix:/run/chat-bcast-audio/native
ExecStart=/usr/lib/chat-bcast/forward
Restart=always
RestartSec=5

[Install]
WantedBy=chat-bcast.target
