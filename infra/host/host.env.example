# chat-uses host configuration.
#
# bootstrap.sh reads this file first, then /etc/chat-uses/host.env if it
# exists. Copy this file there and change only what you need:
#
#   install -D -m 0600 infra/host/host.env.example /etc/chat-uses/host.env
#
# Values must be plain shell assignments (no command substitution).

# --- Host ------------------------------------------------------------------

TIMEZONE="Europe/Paris"

# SSH. Changing the port is supported when sshd runs as ssh.service
# (Debian's default). Keep a second session open when you change it.
SSH_PORT=22
# "prohibit-password" keeps key-based root login (netcup's default way in).
# Set "no" only after ADMIN_USER works with sudo.
SSH_PERMIT_ROOT_LOGIN="prohibit-password"
# Optional non-root admin user. Created with passwordless sudo and the
# incus-admin group; root's authorized_keys are copied to it.
ADMIN_USER=""

# Public interface. Empty = detect from the default route.
WAN_IF=""

# Open 80/443 for the public site (Phase 8). 0 = closed.
PUBLIC_HTTPS=0

# --- Incus source ---------------------------------------------------------------
# zabbly-stable   Latest Incus release, from Zabbly's repository (built and
#                 signed by the Incus project lead; key pinned in
#                 infra/host/zabbly.asc). A new feature release every month.
#                 Needed to restore snapshots in the restricted "targets"
#                 project (PLAN.md D19, D20).
# zabbly-lts-7.0  Incus 7.0 LTS from Zabbly.
# debian          Debian 13's own package (6.0 LTS, Debian security updates).
#                 Snapshot restore in "targets" fails with it.
INCUS_SOURCE="zabbly-stable"

# --- WireGuard admin tunnel ---------------------------------------------------

WG_IF="wg0"
WG_PORT=51820
WG_SUBNET="10.99.0.0/24"
WG_HOST_IP="10.99.0.1"
WG_PREFIX=24
# Public address clients connect to. Empty = first global IPv4 on WAN_IF.
WG_ENDPOINT=""

# --- Incus storage ----------------------------------------------------------

POOL_NAME="chat"
# btrfs gives instant copy-on-write snapshots and per-instance quotas.
POOL_DRIVER="btrfs"
# Size of the loop file backing the pool (sparse; grows as used).
POOL_SIZE="200GiB"

# --- Networks -----------------------------------------------------------------
# infranet: infrastructure containers, NAT to the internet.
# chatnet:  chat-controlled targets, no NAT, no IPv6, no DNS.
# Traffic between them is routed through the host and filtered by nftables.

INFRANET_NAME="infranet"
INFRANET_SUBNET="10.20.0.0/24"
INFRANET_GW="10.20.0.1"
INFRANET_PREFIX=24
INFRANET_DHCP_RANGE="10.20.0.100-10.20.0.199"

CHATNET_NAME="chatnet"
CHATNET_SUBNET="10.30.0.0/24"
CHATNET_GW="10.30.0.1"
CHATNET_PREFIX=24
CHATNET_DHCP_RANGE="10.30.0.100-10.30.0.199"

# Fixed addresses of infrastructure containers (outside the DHCP range).
BCAST_IP="10.20.0.10"
BRAIN_IP="10.20.0.11"
EGRESS_IP="10.20.0.12"
INTRANET_IP="10.20.0.13"

# The target on stream (fixed address on chatnet, below the DHCP range).
# bcast shows and listens to this one (Phase 3).
TARGET_IP="10.30.0.10"

# --- Ports ----------------------------------------------------------------------

VNC_PORT=5900
AUDIO_PORT=4712
QMP_PORT=4444
PROXY_PORT=3128
INTRANET_PORT=80
INCUS_API_PORT=8443
# brain's overlay websocket and admin API (Phase 4).
BRAIN_PORT=8080

# --- CPU pinning (vCPU indexes) -------------------------------------------------
# Use ranges. A single CPU must be written "2-2"; a bare "2" would mean
# "any two CPUs" to Incus.

CPUS_BCAST="0-3"
CPUS_BRAIN="4-4"
CPUS_SHARED="4-4"
CPUS_TARGETS="5-7"

# --- Memory and disk ------------------------------------------------------------

MEM_BCAST="3GiB"
MEM_BRAIN="1536MiB"
MEM_EGRESS="256MiB"
MEM_INTRANET="512MiB"
MEM_TARGET="8GiB"

DISK_BCAST="20GiB"
DISK_BRAIN="10GiB"
DISK_EGRESS="5GiB"
DISK_INTRANET="20GiB"
DISK_TARGET="40GiB"

# --- Target limits --------------------------------------------------------------

TARGET_PROCESSES=2048
TARGET_NET_LIMIT="20Mbit"

# Caps for the whole "targets" project.
TARGETS_MAX_INSTANCES=4
TARGETS_MAX_MEMORY="10GiB"
TARGETS_MAX_DISK="160GiB"
