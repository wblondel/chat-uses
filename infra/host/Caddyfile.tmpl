# The public site (PLAN.md Phase 8, D65): /etc/caddy/Caddyfile, written by
# bootstrap.sh's site step from infra/host/Caddyfile.tmpl. Edit the template.
#
# Caddy gets the certificate for the domain from Let's Encrypt by itself (the
# DNS name must point at this server, and ports 80 and 443 be open:
# PUBLIC_HTTPS=1) and serves the copy infra/host/site_sync.py keeps in
# /var/www/chat-uses. Static files only, no scripts allowed, no cookies.
# No access log: the privacy notice says we keep no visitor's IP address.
{
	admin off
}

${SITE_DOMAIN} {
	root * /var/www/chat-uses
	file_server
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
	@pages path / *.html
	header @pages Cache-Control "public, max-age=60"
	@files path *.png *.css
	header @files Cache-Control "public, max-age=3600"
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
